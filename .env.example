# === AutoClip Environment Variables (v0.4) ===
# Copy to .env and fill in values. NEVER commit .env to git.

# === Storage ===
DATA_DIR=./data

# === Local ASR — faster-whisper (v0.4: zero credentials required) ===
# Model weights cached at ~/.cache/huggingface/hub/ on first use (~3.1GB for large-v3).
# Run `python scripts/preload_whisper.py` to pre-download to avoid first-run latency.
# Optional overrides — defaults work out of the box.
WHISPER_MODEL_SIZE=large-v3        # tiny / base / small / medium / large-v3
WHISPER_DEVICE=auto                # auto / cpu / cuda / mps
WHISPER_COMPUTE_TYPE=default       # default / int8 / float16 / float32

# === Tongyi Qianwen LLM (P0 — required for scripting stage) ===
# Get from: https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === Volcengine TTS (P0 — required for assembly stage) ===
# Get from: https://console.volcengine.com/speech/app
VOLCENGINE_TTS_TOKEN=your_token_here
VOLCENGINE_TTS_APP_ID=your_app_id_here

# === Pipeline ===
MAX_CONCURRENT_JOBS=1

# === Logging ===
LOG_LEVEL=INFO
