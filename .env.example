# === AutoClip Environment Variables ===
# Copy to .env and fill in values. NEVER commit .env to git.

# === Storage ===
DATA_DIR=./data

# === Aliyun ASR (P0 — required for ingest stage) ===
# Get from: https://nls-portal.console.aliyun.com/applist
ALIYUN_ASR_APP_KEY=your_app_key_here
ALIYUN_ASR_TOKEN=your_token_here

# === Tongyi Qianwen LLM (P0 — required for scripting stage) ===
# Get from: https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === Volcengine TTS (P0 — required for assembly stage) ===
# Get from: https://console.volcengine.com/speech/app
VOLCENGINE_TTS_TOKEN=your_token_here
VOLCENGINE_TTS_APP_ID=your_app_id_here

# === Pipeline ===
MAX_CONCURRENT_JOBS=1

# === Logging ===
LOG_LEVEL=INFO
